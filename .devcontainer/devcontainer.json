{
  // ==========================================================================
  // Devcontainer template (hardened) — rendered by `vibe-devcontainer`.
  // --------------------------------------------------------------------------
  // Design choices:
  //   1. Claude Code installed via Anthropic's NATIVE installer (curl script),
  //      not the npm Feature. No Node.js dependency for Claude Code itself,
  //      no npm global-prefix mismatch, and auto-update runs as the `vscode`
  //      user against user-owned paths — the no_permissions failure mode
  //      this replaced can't happen here. Node is kept only because other
  //      tooling (e.g. @openai/codex) still needs it.
  //   2. ~/.claude is a per-project NAMED VOLUME, not a host bind-mount —
  //      project code can't read/exfiltrate your real host credentials, and
  //      parallel containers can't clobber one shared config. This is also
  //      where the native installer keeps its session/auth/settings.
  //   3. Host secret mounts (SSH key, gh token, kubeconfig) are OPT-IN,
  //      commented out by default. Uncomment per-project only when needed.
  //   4. Non-root remoteUser made explicit (required for --dangerously-skip-
  //      permissions and to run the installer as a non-root user).
  //   5. Optional egress firewall shown as a comment.
  // ==========================================================================
  "name": "moomorqklyx",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "runArgs": [
    "--name", "moomorqklyx"
    // --- Optional egress firewall (default-deny outbound) -------------------
    // Requires the reference init-firewall.sh in .devcontainer/ and a matching
    // "postStartCommand". See:
    // https://github.com/anthropics/claude-code/blob/main/.devcontainer/init-firewall.sh
    // , "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"
  ],

  // Non-root user — lets you safely pass --dangerously-skip-permissions and
  // keeps the native installer's writes (and its auto-updater) entirely
  // inside user-owned paths.
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    },
    // Kept for other npm-delivered tooling (e.g. @openai/codex below).
    // No longer required by Claude Code itself.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
    // Removed: ghcr.io/anthropics/devcontainer-features/claude-code:1.0
    // That Feature installs via npm into a root-owned global prefix, which is
    // what caused "Auto-update failed (no_permissions)" — the auto-updater
    // calls `npm i -g @anthropic-ai/claude-code` against npm's *default*
    // prefix, not wherever you actually installed it. The native installer
    // below sidesteps npm entirely.
  },

  // Native installer: downloads the claude binary straight into
  // ~/.local/bin as the `vscode` user — no npm, no root-owned prefix, no
  // prefix-mismatch bug. It self-updates in the background from the same
  // user-owned location, so "Auto-updates: enabled" will actually succeed.
  // @openai/codex still goes through npm since it has no native installer.
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash && npm install -g @openai/codex",

  "mounts": [
    // --- Agent config: per-project named volumes (NOT host bind-mounts) -----
    // ${devcontainerId} isolates each project's auth/session state. You sign in
    // to Claude once per project; your real host credentials are never exposed
    // to project code. State survives container rebuilds. The native
    // installer reads/writes its session, settings, and memory here by
    // default (same ~/.claude path as before — no CLAUDE_CONFIG_DIR needed).
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",

    // --- Git identity (config only, not a secret) — safe to share read-only --
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly"

    // ======================================================================
    // OPT-IN HOST SECRET MOUNTS — uncomment per-project ONLY when needed.
    // Anthropic explicitly advises against mounting host secrets into a
    // devcontainer: with skip-permissions, a malicious dependency in the repo
    // can exfiltrate anything reachable here. Prefer short-lived tokens.
    // ======================================================================
    //
    // SSH key (only if this project pushes over git+ssh):
    // , "source=${localEnv:HOME}/.ssh/id_ed25519,target=/home/vscode/.ssh/id_ed25519,type=bind,readonly"
    // , "source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,consistency=cached"
    //
    // GitHub CLI auth (alternative: run `gh auth login` inside the container,
    // or inject a short-lived token via containerEnv GH_TOKEN below):
    , "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,readonly"
    //
    // Kubeconfig (only if this project talks to your cluster):
    , "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,readonly"
  ],

  // MCP servers: define them per-project in a checked-in .mcp.json at the repo
  // root (project scope), and install any stdio-server binaries in a Dockerfile.
  // This replaces inheriting the host's global ~/.claude.json. See:
  // https://code.claude.com/docs/en/mcp#mcp-installation-scopes

  // ~/.local/bin (the native installer's target) isn't guaranteed to be on
  // PATH in every non-interactive shell a devcontainer spawns, so put it
  // first explicitly.
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },

  "containerEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    // Inject a short-lived GitHub token instead of mounting ~/.config/gh
    // (requires GH_TOKEN exported on the host):
    // , "GH_TOKEN": "${localEnv:GH_TOKEN}"
    //
    // Optional: opt out of non-essential traffic / pin behavior. With the
    // native installer, auto-updates are the whole point of this migration,
    // so leave DISABLE_AUTOUPDATER unset unless you deliberately want to pin
    // a version for reproducible builds (see Anthropic's devcontainer docs
    // on pinning + DISABLE_AUTOUPDATER for that case).
    // , "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}